# Copia este archivo como ".env" y ajusta los valores. NUNCA subas el .env a git.

# "production" activa cookies seguras (https), caché y cabeceras de seguridad
NODE_ENV=production
PORT=3000

# URL pública del sitio, sin "/" al final
SITE_URL=https://www.caelcomex.cl

# Carpeta persistente (base de datos + imágenes + respaldos).
# En Render/Railway/Fly apunta aquí el disco o volumen persistente, ej: /data
DATA_DIR=data

# Usuario administrador inicial (solo se usa la primera vez, cuando la base de datos está vacía)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave-larga

# Respaldos automáticos diarios a conservar
BACKUP_KEEP=14

# Opcional: desactiva https obligatorio en la cookie si pruebas producción sin https
# COOKIE_SECURE=false
